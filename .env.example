# ─── Application ──────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=local

# ─── Database ─────────────────────────────────────────────────────────────────
# These are the variables actually read by backend/src/main/resources/application.yml
DB_HOST=localhost
DB_PORT=5432
DB_NAME=respondr
DB_USERNAME=respondr
DB_PASSWORD=changeme

# ─── JWT ──────────────────────────────────────────────────────────────────────
# HMAC signing key. Must be at least 32 bytes for HS256.
# The value below is the development default and MUST be replaced for any
# non-local deployment. See "Security" in README.md.
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# NOTE: token lifetimes are not environment-driven. They are set in
# application.yml as respondr.jwt.access-token-expiration-ms (900000 / 15 min) and
# respondr.jwt.refresh-token-expiration-ms (604800000 / 7 days).

# ─── Redis (optional) ─────────────────────────────────────────────────────────
# Redis is NOT read from these variables. The backend uses Spring Boot defaults
# (localhost:6379) because no spring.data.redis.* block is configured yet.
# Redis is optional at runtime: every operation fails open to PostgreSQL.
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Kafka (optional) ─────────────────────────────────────────────────────────
# Kafka is NOT read from these variables. The backend uses Spring Boot defaults
# (localhost:9092) because no spring.kafka.* block is configured in
# application.yml. Kafka listeners are disabled in the test profile.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ─── Not yet wired ────────────────────────────────────────────────────────────
# The following are declared in the architecture but are NOT read by any
# current code path. They are listed so the intended configuration is visible.
#
#   ELASTICSEARCH_HOST / ELASTICSEARCH_PORT  — no Elasticsearch dependency exists
#   AWS_REGION / AWS_S3_BUCKET               — no deployment/IaC code exists
#   OTEL_EXPORTER_OTLP_ENDPOINT              — no OpenTelemetry dependency exists
